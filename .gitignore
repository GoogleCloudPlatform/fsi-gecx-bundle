.jetskicli
.DS_Store
.vscode
*.zip
*.db
# SQLite shared-memory schema attachments become literal files if a test
# connection is opened without URI handling.
file:*mode=memory*cache=shared*

# Ignore implementation plans and temp folders
docs/impl-plans/
docs/temp/
docs/notes-and-questions/
docs/research/
.jetskicli/

# Python caching and environment ignores
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.venv/
.ipynb_checkpoints/

# Local SCRAPI diagnostics may contain transcripts and detailed traces.
/scripts/cxas/.artifacts/

# Node.js dependencies and build output ignores
node_modules/
dist/
.npm/
npm-debug.log*

# Local configuration secrets
.env
.env.local
.env.*.local
